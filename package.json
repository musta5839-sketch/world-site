{
  "name": "world-site",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "NODE_ENV=test node --test",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node-pg-migrate up",
    "db:rollback": "node-pg-migrate down",
    "db:create": "node-pg-migrate create",
    "coverage": "NODE_ENV=test c8 --all --include='src/**/*.js' --reporter=text --reporter=html node --test",
    "audit": "npm audit --json",
    "audit:prod": "npm audit --omit=dev",
    "audit:full": "npm audit",
    "deps:inspect": "npm ls glob minimatch",
    "test:coverage": "NODE_ENV=test c8 --all --include='src/**/*.js' --reporter=text --reporter=html --reporter=json --check-coverage --lines 96 --statements 96 --functions 94 --branches 91 node --test"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
